# Bridal Team — environment variables

# ── AI planner ────────────────────────────────────────────────
# The AI planner works out of the box in "demo mode" (smart, rule-based
# replies). To power it with live Claude AI, add your Anthropic API key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Supabase (venues directory) ───────────────────────────────
# The public Bridal Team project is baked in as a default, so the /vendors
# page reads live venues with no config. Override these to point at your own
# Supabase project instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Feature flags ─────────────────────────────────────────────
# The /vendors directory is hidden at launch because the `vendors` table
# currently holds seeded sample data (invented names, no websites, no images).
# Set this to true once it holds real listings to bring the page, the nav
# links and the homepage teaser back. Read at build time -- needs a redeploy.
NEXT_PUBLIC_SHOW_VENDOR_DIRECTORY=

# ── Vendor admin (/admin/venues) ──────────────────────────────
# Both are REQUIRED to add/edit/delete venues from the admin page.
# Find the service-role key in Supabase → Project Settings → API → service_role
# (keep it secret — server-only, never commit it).
SUPABASE_SERVICE_ROLE_KEY=
# Any strong passphrase you choose; you'll type it to unlock /admin/venues.
ADMIN_PASSWORD=
