# Root env for GCE deployment
# Copy to .env.gcp and fill in values

# Cloud SQL: project:region:instance
CLOUD_SQL_CONNECTION_NAME=your-project:your-region:your-instance

# Database credentials (must match users created in Cloud SQL)
DB_DATABASE=bridalteam
DB_USERNAME=bridalteam_user
DB_PASSWORD=change_me

# Optional
APP_ENV=production
APP_DEBUG=false
APP_URL=http://YOUR_VM_EXTERNAL_IP


