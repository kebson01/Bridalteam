# Production Environment Variables
# Copy this file to .env and update with your actual production values

# Database Configuration
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_DATABASE=bridalteam
DB_USERNAME=bridalteam_user
DB_PASSWORD=your_secure_database_password_here

# Application Configuration
APP_KEY=your_32_character_app_key_here
JWT_SECRET=your_jwt_secret_key_here

# External Services
STRIPE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Mail Configuration
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password

# Domain Configuration
DOMAIN_NAME=your-domain.com

# SSL Certificate paths (if using custom certificates)
SSL_CERT_PATH=./docker/nginx/ssl/cert.pem
SSL_KEY_PATH=./docker/nginx/ssl/key.pem


