# Production Environment Variables for DigitalOcean
# Copy this file to production.env and update with your actual values

APP_NAME=Bridalteam
APP_ENV=production
APP_DEBUG=false
APP_KEY=your_app_key_here
# Generate with: php artisan jwt:secret --show  (never leave blank or use a default)
JWT_SECRET=your_jwt_secret_here
APP_URL=https://your-domain.com

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bridalteam
DB_USERNAME=bridalteam_user
DB_PASSWORD=your_secure_database_password
DB_ROOT_PASSWORD=your_secure_root_password

# Cache and Session Configuration
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# CORS Configuration
ALLOW_ORIGIN=https://your-domain.com

# SEO Configuration
SEO_SITETITLE=Bridal Team - Wedding Planning Made Simple
